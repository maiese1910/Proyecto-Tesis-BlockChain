{
  "build": {
    "env": {
      "PUPPETEER_SKIP_DOWNLOAD": "true"
    }
  },
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/ocr(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/blockchain(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/stats(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/prevalidation(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/health",
      "dest": "/api/main.py"
    },
    {
      "src": "/student/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/documents/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/admin/(login|users|checklist|guias|planillas|clean-test-data|reset-demo-records)(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/profiles(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/chat(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/hash(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/carreras",
      "dest": "/api/main.py"
    },
    {
      "src": "/guias",
      "dest": "/api/main.py"
    },
    {
      "src": "/planillas",
      "dest": "/api/main.py"
    },
    {
      "src": "/pub(.*)",
      "dest": "/api/main.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
