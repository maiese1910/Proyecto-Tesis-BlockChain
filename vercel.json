{
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/stats",
      "dest": "/api/main.py"
    },
    {
      "src": "/blockchain/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/ws/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/profiles/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/chat/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/hash/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/carreras",
      "dest": "/api/main.py"
    },
    {
      "src": "/guias",
      "dest": "/api/main.py"
    },
    {
      "src": "/planillas",
      "dest": "/api/main.py"
    },
    {
      "src": "/pub/(.*)",
      "dest": "/api/main.py"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
