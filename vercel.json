{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/ping", "destination": "/api/ping.py" },
    { "source": "/api/ping", "destination": "/api/ping.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/stats/(.*)", "destination": "/api/index.py" },
    { "source": "/stats", "destination": "/api/index.py" },
    { "source": "/blockchain/(.*)", "destination": "/api/index.py" },
    { "source": "/blockchain", "destination": "/api/index.py" },
    { "source": "/ocr/(.*)", "destination": "/api/index.py" },
    { "source": "/ocr", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/admin/(.*)", "destination": "/api/index.py" },
    { "source": "/admin", "destination": "/api/index.py" },
    { "source": "/profiles/(.*)", "destination": "/api/index.py" },
    { "source": "/profiles", "destination": "/api/index.py" },
    { "source": "/chat/(.*)", "destination": "/api/index.py" },
    { "source": "/chat", "destination": "/api/index.py" },
    { "source": "/hash/(.*)", "destination": "/api/index.py" },
    { "source": "/hash", "destination": "/api/index.py" },
    { "source": "/carreras", "destination": "/api/index.py" },
    { "source": "/guias", "destination": "/api/index.py" },
    { "source": "/planillas", "destination": "/api/index.py" },
    { "source": "/pub/(.*)", "destination": "/api/index.py" },
    { "source": "/pub", "destination": "/api/index.py" },
    { "source": "/((?!assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
