# ==============================================================================
# CONFIGURACIÓN DEL BACKEND (FLASK)
# ==============================================================================
PORT=8000
FLASK_OCR_PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=reemplazar-por-secreto-jwt-seguro

# ==============================================================================
# CONECTIVIDAD BLOCKCHAIN (ETHEREUM SEPOLIA)
# ==============================================================================
WEB3_PROVIDER_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=
WALLET_PRIVATE_KEY=

# ==============================================================================
# BASE DE DATOS Y PERSISTENCIA (SUPABASE)
# ==============================================================================
SUPABASE_URL=
SUPABASE_KEY=

# ==============================================================================
# INTELIGENCIA ARTIFICIAL & OCR (OPCIONAL — EL OCR FUNCIONA SIN API KEY)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# ALMACENAMIENTO DESCENTRALIZADO (IPFS & PINATA)
# ==============================================================================
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# ==============================================================================
# MODO DE DEFENSA DE TESIS
# ==============================================================================
ALLOW_DEFENSE_DEMO_FALLBACK=true

# ==============================================================================
# CORREO ELECTRÓNICO Y NOTIFICACIONES (GMAIL SMTP GRATIS O RESEND API)
# ==============================================================================
# Opción 1 (Recomendada y gratuita para cualquier correo): Gmail + Contraseña de Aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Opción 2 (Alternativa HTTP API): Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=USM ApostillaBot <onboarding@resend.dev>
# Correos de los entes auditores para recibir alertas automáticas de expedientes:
GTU_ADMIN_EMAIL=
MPPRE_ADMIN_EMAIL=

# ==============================================================================
# CONFIGURACIÓN DEL FRONTEND (VITE)
# ==============================================================================
VITE_API_URL=http://localhost:8000
VITE_CONTRACT_ADDRESS=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
